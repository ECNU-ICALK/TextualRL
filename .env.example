# Copy to .env, replace these values, then export them into your shell.
# The CLI reads environment variables; it does not automatically load .env.
# Use separately issued credentials for the target and optimizer roles.
TARGET_API_KEY=replace-with-target-api-key
TARGET_BASE_URL=https://target.example.com/v1
OPTIMIZER_API_KEY=replace-with-optimizer-api-key
OPTIMIZER_BASE_URL=https://optimizer.example.com/v1
